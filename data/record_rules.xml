    <field name="perm_unlink" eval="True"/>
    <field name="active" eval="True"/>
  </record>

  <record id="rule_680_applicant_interviewer" model="ir.rule">
    <field name="name">Applicant Interviewer</field>
    <field name="model_id" ref="BugFix-HR.model_hr_applicant"/>
    <field name="domain_force">[
            '|',
                ('job_id.interviewer_ids', 'in', user.id),
                ('interviewer_ids', 'in', user.id),
        ]</field>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
    <field name="active" eval="True"/>
    <field name="groups" eval="[(6, 0, [ref('hr_recruitment.group_hr_recruitment_interviewer')])]"/>
  </record>

  <record id="rule_772_user_all_applicants" model="ir.rule">
    <field name="name">User: All Applicants</field>
    <field name="model_id" ref="BugFix-HR.model_hr_applicant"/>
    <field name="domain_force">[(1, '=', 1)]</field>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_unlink" eval="True"/>
    <field name="active" eval="True"/>
    <field name="groups" eval="[(6, 0, [ref('hr_recruitment.group_hr_recruitment_user')])]"/>
  </record>

  <record id="rule_384_employee_multi_company_rule" model="ir.rule">
    <field name="name">Employee multi company rule</field>
    <field name="model_id" ref="hr_attendance.model_hr_attendance_overtime"/>
    <field name="domain_force">['|',('employee_id.company_id','=',False),('employee_id.company_id', 'in', company_ids)]</field>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_unlink" eval="True"/>
    <field name="active" eval="True"/>
  </record>

  <record id="rule_747_attendance_officer_restrict_overtime_to_managed_employees" model="ir.rule">
    <field name="name">Attendance Officer: Restrict Overtime to managed employees</field>
    <field name="model_id" ref="hr_attendance.model_hr_attendance_overtime"/>
    <field name="domain_force">[
                '|',
                '&amp;',
                 ('employee_id.attendance_manager_id', '=', user.id),
                 ('employee_id.user_id', '=', user.id),
                '&amp;',
                ('employee_id.user_id', '!=', user.id),
                ('employee_id.attendance_manager_id', '=', user.id)
                ]</field>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_unlink" eval="True"/>
    <field name="active" eval="True"/>
    <field name="groups" eval="[(6, 0, [ref('hr_attendance.group_hr_attendance_officer')])]"/>
  </record>

  <record id="rule_748_attendance_admin_full_access" model="ir.rule">
    <field name="name">Attendance Admin: full access</field>
    <field name="model_id" ref="hr_attendance.model_hr_attendance_overtime"/>
    <field name="domain_force">[(1,'=',1)]</field>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="True"/>
    <field name="perm_create" eval="True"/>
    <field name="perm_unlink" eval="True"/>
    <field name="active" eval="True"/>
    <field name="groups" eval="[(6, 0, [ref('hr_attendance.group_hr_attendance_manager')])]"/>
  </record>

  <record id="rule_749_attendance_base_user_read_his_own_overtime" model="ir.rule">
    <field name="name">Attendance base user: Read his own overtime</field>
    <field name="model_id" ref="hr_attendance.model_hr_attendance_overtime"/>
    <field name="domain_force">[('employee_id.user_id', '=', user.id)]</field>
    <field name="perm_read" eval="True"/>
    <field name="perm_write" eval="False"/>
    <field name="perm_create" eval="False"/>
    <field name="perm_unlink" eval="False"/>
    <field name="active" eval="True"/>
    <field name="groups" eval="[(6, 0, [ref('hr_attendance.group_hr_attendance_own_reader')])]"/>
  </record>

