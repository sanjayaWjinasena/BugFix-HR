    <record id="workers_rule_epf_8" model="hr.salary.rule">
      <field name="name">EPF 8%</field>
      <field name="code">EPF 8%</field>
      <field name="sequence">5</field>
      <field name="struct_id" ref="workers_payroll_structure"/>
      <field name="category_id" ref="hr_payroll.DED"/>
      <field name="appears_on_payslip" eval="True"/>
      <field name="quantity">1.0</field>
      <field name="condition_select">none</field>
      <field name="condition_python"><![CDATA[
# Available variables:
#----------------------
# payslip: hr.payslip object
# employee: hr.employee object
# contract: hr.contract object
# rules: dict containing the rules code (previously computed)
# categories: dict containing the computed salary rule categories (sum of amount of all rules belonging to that category).
# worked_days: dict containing the computed worked days
# inputs: dict containing the computed inputs.

# Note: returned value have to be set in the variable 'result'

result = rules['NET']['total'] > categories['NET'] * 0.10]]></field>
      <field name="condition_range">contract.wage</field>
      <field name="amount_select">code</field>
      <field name="amount_python_compute"><![CDATA[ot_line = inputs.get('OT_HOLIDAY')
ot_amount = ot_line.amount if ot_line else 0

epf_base = ( contract.wage
           + contract.x_studio_gbud_a
           + contract.x_studio_gbud_l2
           + ot_amount )
result = -epf_base * 0.08]]></field>
    </record>
