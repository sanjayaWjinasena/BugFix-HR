<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <!-- Workers Payroll salary structure and its 23 rules, ported verbatim from v17-final
       (hr.payroll.structure 16). Pays the Statutory Allowance tab amounts of Worker contracts
       (Ex-gratia, Government Budget A / L2, Special Allowance, Production Incentive) and the
       Workers EPF/ETF. noupdate: payroll users maintain these rules after install. -->
  <data noupdate="1">
    <record id="workers_payroll_structure" model="hr.payroll.structure">
      <field name="name">Workers Payroll</field>
      <field name="type_id" ref="hr_contract.structure_type_worker"/>
      <field name="report_id" ref="hr_payroll.action_report_payslip"/>
      <field name="country_id" eval="False"/>
      <field name="schedule_pay">monthly</field>
      <field name="use_worked_day_lines" eval="True"/>
      <field name="input_line_type_ids" eval="[(6, 0, [ref('hr_payroll.input_deduction'), ref('hr_payroll.input_reimbursement'), ref('hr_payroll.input_attachment_salary'), ref('hr_payroll.input_assignment_salary'), ref('hr_payroll.input_child_support')])]"/>
      <field name="unpaid_work_entry_type_ids" eval="[(6, 0, [ref('hr_work_entry.work_entry_type_attendance'), ref('hr_work_entry_contract.work_entry_type_leave'), ref('hr_work_entry_contract.work_entry_type_compensatory'), ref('hr_work_entry_contract.work_entry_type_home_working'), ref('hr_work_entry_contract.work_entry_type_unpaid_leave'), ref('hr_work_entry_contract.work_entry_type_sick_leave'), ref('hr_work_entry_contract.work_entry_type_legal_leave'), ref('hr_payroll.hr_work_entry_type_out_of_contract')])]"/>
      <field name="rule_ids" eval="[]"/>
    </record>
    <!-- Salary Payment journal for its own company (journal_id is company dependent) -->
    <function model="hr.payroll.structure" name="_bugfix_hr_setup_workers_payroll"/>
    <record id="workers_rule_basic" model="hr.salary.rule">
      <field name="name">Basic Salary</field>
      <field name="code">BASIC</field>
      <field name="sequence">1</field>
      <field name="struct_id" ref="workers_payroll_structure"/>
      <field name="category_id" ref="hr_payroll.BASIC"/>
      <field name="appears_on_payslip" eval="True"/>
      <field name="quantity">1.0</field>
      <field name="condition_select">none</field>
      <field name="condition_python"><![CDATA[
# Available variables:
#----------------------
# payslip: object containing the payslips
# employee: hr.employee object
# contract: hr.contract object
# rules: object containing the rules code (previously computed)
# categories: object containing the computed salary rule categories (sum of amount of all rules belonging to that category).
# worked_days: object containing the computed worked days
# inputs: object containing the computed inputs.

# Note: returned value have to be set in the variable 'result'

result = (rules.get("NET") or 0) > (categories.get("NET") or 0) * 0.10]]></field>
      <field name="condition_range">contract.wage</field>
      <field name="amount_select">code</field>
      <field name="amount_python_compute"><![CDATA[result = payslip.paid_amount]]></field>
    </record>
    <record id="workers_rule_ot_normal" model="hr.salary.rule">
      <field name="name">OT Normal</field>
      <field name="code">OT_NORMAL</field>
      <field name="sequence">5</field>
      <field name="struct_id" ref="workers_payroll_structure"/>
      <field name="category_id" ref="hr_payroll.ALW"/>
      <field name="appears_on_payslip" eval="True"/>
      <field name="quantity">1.0</field>
      <field name="condition_select">python</field>
      <field name="condition_python"><![CDATA[result = inputs.get('OT_NORMAL') and inputs['OT_NORMAL'].amount or 0]]></field>
      <field name="condition_range">contract.wage</field>
      <field name="amount_select">code</field>
      <field name="amount_python_compute"><![CDATA[ot_inp = inputs.get('OT_NORMAL')
result = ot_inp.amount if ot_inp else 0]]></field>
    </record>
