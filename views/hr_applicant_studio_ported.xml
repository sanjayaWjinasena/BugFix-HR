<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ported_odoo_studio_jobs_rec_1902edaf_d88f_4262_9db0_a090d5d60080" model="ir.ui.view">
    <field name="name">Odoo Studio: Jobs - Recruitment Form customization</field>
    <field name="model">hr.applicant</field>
    <field name="type">form</field>
    <field name="priority">99</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="hr_recruitment.hr_applicant_view_form"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//field[@name='date_closed']" position="after">
          <field name="x_studio_priority" string="Line Manager Selection" readonly="x_studio_cu_line_manager == False"/>
          <field name="x_studio_2nd_selection" string="Leadership Selection" readonly="x_studio_cu_leadership == False"/>
          <field name="x_studio_marks_1" string="Recruiter Assignment Marks %" readonly="x_studio_cu_recruiter == False"/>
          <field name="x_studio_line_manager_name" string="Line Manager Name"/>
          <field name="x_studio_interview_marks_1" string="Line Manager Marks %" readonly="x_studio_cu_line_manager == False"/>
          <field name="x_studio_cu_line_manager" string="CU - Line Manager" force_save="True" readonly="1" invisible="1"/>
          <field name="x_studio_leadership_name" string="Leadership Name"/>
          <field name="x_studio_interview_marks_2" string="Leadership Marks %" readonly="x_studio_cu_leadership == False"/>
          <field name="x_studio_cu_leadership" string="CU - Leadership" force_save="True" readonly="1" invisible="1"/>
          <xpath expr="//field[@name='user_id']" position="move"/>
          <field name="x_studio_recruiter" string="Recruiter"/>
          <field name="x_studio_interview_marks_3" string="Recruiter Marks %" readonly="x_studio_cu_recruiter == False"/>
          <field name="x_studio_total_marks" string="Total Marks" widget="progressbar" force_save="True" readonly="1"/>
          <field name="x_studio_cu_recruiter" string="CU - Recruiter" force_save="True" readonly="1" invisible="1"/>
        </xpath>
        <xpath expr="//field[@name='user_id']" position="attributes">
          <attribute name="force_save">True</attribute>
          <attribute name="invisible">1</attribute><attribute name="readonly">1</attribute></xpath>
      </data>
    </field>
  </record>
</odoo>
