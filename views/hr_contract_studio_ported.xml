<?xml version="1.0" encoding="utf-8"?>
<!--
    BugFix-HR v0.0.17: view 4930 hr.contract form Studio inherit (785b).
    Byte-verbatim from Clear-DB. All 12 field refs resolve on target
    (all shipped in v0.0.16).

    Adds 12 x_studio_ fields to the base hr.contract form in 3 groups:
      * After employee_id: initial, surname, occupation_grade (identity)
      * After wage_type: paye_tax_amount, ot_rate, ot_hours (payroll)
      * Inside 'yearly_benefits' group: gbud_a, gbud_l2, standing_order_1,
        std_ord2, travelling_allowance, ex_gratia (compensation)

    0 hardcoded refs. 0 sentinels. 0 studio_approval attributes.
-->
<odoo>

    <record id="ported_view_4930_hr_contract_form" model="ir.ui.view">
        <field name="name">Odoo Studio: hr.contract.form customization</field>
        <field name="model">hr.contract</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='employee_id']" position="after">
                    <field name="x_studio_initial"/>
                    <field name="x_studio_surname"/>
                    <field name="x_studio_occupation_grade"/>
                </xpath>
                <xpath expr="//field[@name='wage_type']" position="after">
                    <field name="x_studio_paye_tax_amount" string="Paye Tax Amount"/>
                    <field name="x_studio_ot_rate" string="OT Rate"/>
                    <field name="x_studio_ot_hours" string="OT Hours"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Statutory Allowance" name="statutory_allowance">
                        <group>
                            <group>
                                <field name="x_studio_gbud_a"/>
                                <field name="x_studio_gbud_l2"/>
                                <field name="x_studio_travelling_allowance"/>
                                <field name="x_studio_ex_gratia"/>
                                <field name="x_studio_special_allowance"/>
                            </group>
                            <group>
                                <field name="x_studio_production_incentive"/>
                                <field name="x_studio_asian_alliance_insurance"/>
                                <field name="x_studio_union_insurance"/>
                                <field name="x_studio_standing_order_1"/>
                                <field name="x_studio_std_ord2"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>

</odoo>
