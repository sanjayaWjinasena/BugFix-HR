<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_paye_tax" model="ir.actions.act_window">
    <field name="name">Paye Tax</field>
    <field name="res_model">paye_tax</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_paye_tax_form" model="ir.ui.view">
      <field name="name">Default form view for paye_tax</field>
      <field name="model">paye_tax</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form>
  <header/>
  <sheet string="Paye Tax">
    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="active == True"/>
    <field name="active" invisible="1"/>
    <div class="oe_title">
                <h1>
                    <field name="name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_c9b4af">
      <group name="studio_group_c9b4af_left">
        <field name="user_id" widget="many2one_avatar_user"/>
        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
      </group>
      <group name="studio_group_c9b4af_right"/>
    </group>
  </sheet>
  <div class="oe_chatter" name="oe_chatter">
    <field name="message_follower_ids"/>
    <field name="message_ids"/>
    <field name="activity_ids"/>
  </div>
</form>
      </field>
    </record>
    <record id="view_paye_tax_list" model="ir.ui.view">
      <field name="name">Default list view for paye_tax</field>
      <field name="model">paye_tax</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree>
  <field name="sequence" widget="handle"/>
  <field name="name"/>
  <field name="user_id" widget="many2one_avatar_user"/>
  <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
</tree>
      </field>
    </record>
    <record id="view_paye_tax_search" model="ir.ui.view">
      <field name="name">Default search view for paye_tax</field>
      <field name="model">paye_tax</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="name"/>
  <field name="user_id"/>
  <field name="tag_ids"/>
  <filter string="My Paye Tax" name="my_paye_tax" domain="[['user_id', '=', uid]]"/>
  <separator/>
  <filter string="Archived" name="archived_paye_tax" domain="[['active', '=', False]]"/>
  <separator/>
  <filter name="groupby_x_user" string="Responsible" context="{'group_by': 'user_id'}" domain="[]"/>
</search>
      </field>
    </record>
    <record id="view_default_list_view_for_paye_tax_inherit" model="ir.ui.view">
      <field name="name">Odoo Studio: Default list view for paye_tax customization</field>
      <field name="model">paye_tax</field>
      <field name="type">tree</field>
      <field name="priority">99</field>
      <field name="inherit_id" ref="BugFix-HR.view_paye_tax_list"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//tree[1]" position="attributes">
    <attribute name="editable">bottom</attribute>
  </xpath>
  <xpath expr="//field[@name='name']" position="attributes">
    <attribute name="string">Code</attribute>
  <attribute name="required">1</attribute></xpath>
  <xpath expr="//field[@name='name']" position="after">
    <field name="start_date" string="Start Date" required="1"/>
    <field name="end_date" string="End Date" required="1"/>
    <field name="from_value" string="From Value" required="1"/>
    <field name="to_value" string="To Value" required="1"/>
    <field name="tax_amount" string="Tax Amount" required="1"/>
  </xpath>
  <xpath expr="//field[@name='user_id']" position="attributes">
    <attribute name="column_invisible">1</attribute></xpath>
</data>
      </field>
    </record>
</odoo>
