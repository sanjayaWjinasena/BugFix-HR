<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="aw_f4_hr_contract_etf_schedule" model="ir.actions.act_window">
    <field name="name">ETF Schedule</field>
    <field name="res_model">hr.contract</field>
    <field name="view_mode">kanban,tree,form,activity</field>
  </record>
    <record id="view_hr_contract_form_inherit" model="ir.ui.view">
        <field name="name">Odoo Studio: hr.contract.form customization</field>
        <field name="model">hr.contract</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='employee_id']" position="after">
                    <field name="initial"/>
                    <field name="surname"/>
                    <field name="occupation_grade"/>
                </xpath>
                <xpath expr="//field[@name='wage_type']" position="after">
                    <field name="paye_tax_amount" string="Paye Tax Amount"/>
                    <field name="ot_rate" string="OT Rate"/>
                    <field name="ot_hours" string="OT Hours"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                    <page string="Statutory Allowance" name="statutory_allowance">
                        <group>
                            <group>
                                <field name="gbud_a"/>
                                <field name="gbud_l2"/>
                                <field name="travelling_allowance"/>
                                <field name="ex_gratia"/>
                                <field name="special_allowance"/>
                            </group>
                            <group>
                                <field name="production_incentive"/>
                                <field name="asian_alliance_insurance"/>
                                <field name="union_insurance"/>
                                <field name="standing_order_1"/>
                                <field name="std_ord2"/>
                            </group>
                        </group>
                    </page>
                </xpath>
            </data>
        </field>
    </record>
  <record id="action_etf_schedule" model="ir.actions.act_window">
    <field name="name">ETF Schedule</field>
    <field name="res_model">hr.contract</field>
    <field name="view_mode">kanban,tree,form,activity</field>
    <field name="context">{}</field>
    <field name="help" type="html"><p class="o_view_nocontent_smiling_face">
                    This is your new action.
                </p>
                <p>By default, it contains a list and a form view and possibly
                    other view types depending on the options you chose for your model.
                </p>
                <p>
                    You can start customizing these screens by clicking on the Studio icon on the
                    top right corner (you can also customize this help message there).
                </p>
            </field>
  </record>
  <record id="action_etf_schedule" model="ir.actions.act_window">
    <field name="name">ETF Schedule</field>
    <field name="res_model">hr.contract</field>
    <field name="view_mode">kanban,tree,form,activity</field>
  </record>
</odoo>
