<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="action_paye_tax_tags" model="ir.actions.act_window">
    <field name="name">Paye Tax Tags</field>
    <field name="res_model">paye_tax_tag</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_paye_tax_tag_form" model="ir.ui.view">
      <field name="name">Default form view for paye_tax_tag</field>
      <field name="model">paye_tax_tag</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form>
  <header/>
  <sheet string="Paye Tax Tags">
    <div class="oe_title">
                <h1>
                    <field name="name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_cd5063">
      <group name="studio_group_cd5063_left"/>
      <group name="studio_group_cd5063_right"/>
    </group>
  </sheet>
</form>
      </field>
    </record>
    <record id="view_paye_tax_tag_list" model="ir.ui.view">
      <field name="name">Default list view for paye_tax_tag</field>
      <field name="model">paye_tax_tag</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree editable="bottom">
  <field name="name"/>
  <field name="color" widget="color_picker"/>
</tree>
      </field>
    </record>
    <record id="view_paye_tax_tag_search" model="ir.ui.view">
      <field name="name">Default search view for paye_tax_tag</field>
      <field name="model">paye_tax_tag</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="name"/>
</search>
      </field>
    </record>
</odoo>
