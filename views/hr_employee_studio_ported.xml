<?xml version="1.0" encoding="utf-8"?>
<!--
    BugFix-HR v0.0.24: view 4929 hr.employee form Studio inherit (721b).
    Byte-verbatim from Clear-DB.

    Adds 8 x_studio_ fields to the hr.employee form in 2 groups:
      * After emergency_phone: x_studio_epf_no, x_studio_etf_no,
        x_studio_purpose_code
      * After user_id in hr_settings page: x_studio_occupation_code,
        x_studio_ot_hours, x_studio_ot_month, x_studio_ot_rate,
        x_studio_employee_rate

    All 8 fields shipped in models/hr_employee.py (pre-existing).
    0 hardcoded refs. 0 sentinels needed.
-->
<odoo>

    <record id="ported_view_4929_hr_employee_form" model="ir.ui.view">
        <field name="name">Odoo Studio: hr.employee.form customization</field>
        <field name="model">hr.employee</field>
        <field name="type">form</field>
        <field name="priority">99</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <data>
                <xpath expr="//field[@name='emergency_phone']" position="after">
                    <field name="x_studio_epf_no" string="EPF No"/>
                    <field name="x_studio_etf_no" string="ETF No"/>
                    <field name="x_studio_purpose_code" string="Purpose Code"/>
                </xpath>
                <xpath expr="//form[1]/sheet[1]/notebook[1]/page[@name='hr_settings']/group[1]/group[@name='active_group']/field[@name='user_id']" position="after">
                    <field name="x_studio_occupation_code"/>
                    <field name="x_studio_ot_hours" string="OT Hours" widget="float_time"/>
                    <field name="x_studio_ot_month" widget="float_time"/>
                    <field name="x_studio_ot_rate" string="OT Rate"/>
                    <field name="x_studio_employee_rate" string="Employee Rate"/>
                </xpath>
            </data>
        </field>
    </record>

</odoo>
