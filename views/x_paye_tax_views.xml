<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="act_window_1559_paye_tax" model="ir.actions.act_window">
    <field name="name">Paye Tax</field>
    <field name="res_model">x_paye_tax</field>
    <field name="view_mode">tree,form</field>
  </record>
    <record id="view_3238_default_form_view_for_x_paye_tax_e" model="ir.ui.view">
      <field name="name">Default form view for x_paye_tax</field>
      <field name="model">x_paye_tax</field>
      <field name="type">form</field>
      <field name="arch" type="xml">
        <form>
  <header/>
  <sheet string="Paye Tax">
    <widget name="web_ribbon" text="Archived" bg_color="bg-danger" invisible="x_active == True"/>
    <field name="x_active" invisible="1"/>
    <div class="oe_title">
                <h1>
                    <field name="x_name" required="1" placeholder="Name..."/>
                </h1>
            </div>
    <group name="studio_group_c9b4af">
      <group name="studio_group_c9b4af_left">
        <field name="x_studio_user_id" widget="many2one_avatar_user"/>
        <field name="x_studio_tag_ids" widget="many2many_tags" options="{'color_field': 'x_color'}"/>
      </group>
      <group name="studio_group_c9b4af_right"/>
    </group>
  </sheet>
  <div class="oe_chatter" name="oe_chatter">
    <field name="message_follower_ids"/>
    <field name="message_ids"/>
    <field name="activity_ids"/>
  </div>
</form>
      </field>
    </record>
    <record id="view_3237_default_list_view_for_x_paye_tax_e" model="ir.ui.view">
      <field name="name">Default list view for x_paye_tax</field>
      <field name="model">x_paye_tax</field>
      <field name="type">tree</field>
      <field name="arch" type="xml">
        <tree>
  <field name="x_studio_sequence" widget="handle"/>
  <field name="x_name"/>
  <field name="x_studio_user_id" widget="many2one_avatar_user"/>
  <field name="x_studio_tag_ids" widget="many2many_tags" options="{'color_field': 'x_color'}"/>
</tree>
      </field>
    </record>
    <record id="view_3239_default_search_view_for_x_paye_tax_e" model="ir.ui.view">
      <field name="name">Default search view for x_paye_tax</field>
      <field name="model">x_paye_tax</field>
      <field name="type">search</field>
      <field name="arch" type="xml">
        <search>
  <field name="x_name"/>
  <field name="x_studio_user_id"/>
  <field name="x_studio_tag_ids"/>
  <filter string="My Paye Tax" name="my_x_paye_tax" domain="[['x_studio_user_id', '=', uid]]"/>
  <separator/>
  <filter string="Archived" name="archived_x_paye_tax" domain="[['x_active', '=', False]]"/>
  <separator/>
  <filter name="groupby_x_user" string="Responsible" context="{'group_by': 'x_studio_user_id'}" domain="[]"/>
</search>
      </field>
    </record>
    <record id="view_final_x_paye_tax_odoo_studio_default_list_view_for_x_paye_tax_customization" model="ir.ui.view">
      <field name="name">Odoo Studio: Default list view for x_paye_tax customization</field>
      <field name="model">x_paye_tax</field>
      <field name="type">tree</field>
      <field name="priority">99</field>
      <field name="inherit_id" ref="BugFix-HR.view_3237_default_list_view_for_x_paye_tax_e"/>
      <field name="mode">extension</field>
      <field name="arch" type="xml">
        <data>
  <xpath expr="//tree[1]" position="attributes">
    <attribute name="editable">bottom</attribute>
  </xpath>
  <xpath expr="//field[@name='x_name']" position="attributes">
    <attribute name="string">Code</attribute>
  <attribute name="required">1</attribute></xpath>
  <xpath expr="//field[@name='x_name']" position="after">
    <field name="x_studio_start_date" string="Start Date" required="1"/>
    <field name="x_studio_end_date" string="End Date" required="1"/>
    <field name="x_studio_from_value" string="From Value" required="1"/>
    <field name="x_studio_to_value" string="To Value" required="1"/>
    <field name="x_studio_tax_amount" string="Tax Amount" required="1"/>
  </xpath>
  <xpath expr="//field[@name='x_studio_user_id']" position="attributes">
    <attribute name="column_invisible">1</attribute></xpath>
</data>
      </field>
    </record>
</odoo>
