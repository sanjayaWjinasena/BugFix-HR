<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="ported_odoo_studio_hr_job_f_7b8bfbf6_206e_44fc_a575_a1752d80aa0e" model="ir.ui.view">
    <field name="name">Odoo Studio: hr.job.form customization</field>
    <field name="model">hr.job</field>
    <field name="type">form</field>
    <field name="priority">160</field>
    <field name="mode">extension</field>
    <field name="inherit_id" ref="hr.view_hr_job_form"/>
    <field name="arch" type="xml">
      <data>
        <xpath expr="//field[@name='no_of_recruitment']" position="after">
          <field name="x_studio_line_manager_name" string="Line Manager Name"/>
          <field name="x_studio_leadership_name" string="Leadership Name"/>
        </xpath>
        <xpath expr="//field[@name='user_id']" position="after">
          <field name="x_studio_link" string="Link"/>
          <field filename="x_studio_test_document_filename" name="x_studio_test_document" string="Test Document" required="False" widget="pdf_viewer"/>
          <field invisible="1" name="x_studio_test_document_filename"/>
        </xpath>
      </data>
    </field>
  </record>
</odoo>
